@article{zhang2026gpi,
  author = {Zhang, Yijiao and Li, Hongzhe},
  title = {Generation-Powered Inference for Distribution-valued Outcomes},
  year = {2026},
  url = {https://arxiv.org/abs/2608.14542},
  abstract = {Modern generative models increasingly provide distribution-valued predictions that can serve as auxiliary information for scientific inference, but their outputs may be systematically misspecified. We develop generation-powered inference (GPI), a framework for improving inference on distribution-valued targets without requiring the generative model to be correct. For Wasserstein barycenters and related functionals, a function-valued bridge representation maps the nonlinear Wasserstein problem to mean estimation in a Hilbert space, enabling calibrated augmentation by generated data. We construct estimators with adaptive information borrowing and establish consistency, asymptotic normality, simultaneous confidence bands, and valid inference for linear functionals and Wasserstein distances. Simulations demonstrate efficiency gains and robustness to generator misspecification. An application to K562 Perturb-seq data uses responses generated by a cellular foundation model to improve inference for pathway-level expression distributions.}
}

@article{zhang2026dag,
  author = {Zhang, Yijiao and Li, Hongzhe},
  title = {Causal Network Discovery from Interventional Count Data with Latent Linear {DAGs}},
  year = {2026},
  url = {https://arxiv.org/abs/2603.25838},
  abstract = {Interventional count data provide valuable directional information for causal discovery but are complicated by sequencing noise, measurement error, and latent cellular heterogeneity. We study a latent structural causal model in which a linear Gaussian directed acyclic graph governs unobserved expression levels and a Poisson measurement layer produces the observed counts. Targeted intervention-induced shifts supply the information needed to identify the latent causal structure under appropriate coverage and separation conditions. Building on this identification argument, we recover latent moments from the count data and estimate a sparse acyclic coefficient matrix using inverse-matrix and structural constraints. We establish nonasymptotic estimation bounds and finite-sample graph recovery guarantees that connect measurement error, intervention strength, and edge separation to causal recovery. Simulations and Perturb-seq applications demonstrate the practical performance of the proposed approach.}
}

@article{zhang2026beir,
  author = {Zhang, Ruqian and Shen, Juan and Zhang, Yijiao},
  title = {Bayesian Environment Invariant Regression},
  year = {2026},
  url = {https://arxiv.org/abs/2604.25754},
  abstract = {Data collected across heterogeneous environments can contain both stable response mechanisms and environment-specific associations. We develop Bayesian Environment Invariant Regression (BEIR), which models these two sources of dependence separately and uses environmental heterogeneity as evidence for invariant structure learning. A competitive spike-and-slab prior assigns each predictor to an invariant response effect or to non-invariant, potentially spurious associations, allowing the posterior to learn the stable mechanism directly from multi-environment data. Under a tractable working model, we establish invariant-model selection consistency and posterior contraction for the invariant coefficients. We further analyze irrelevant predictors, posterior concentration on equivalent invariant classes, and a post-selection refinement for recovering the minimal invariant model. Simulation studies and an application to protein-signaling data illustrate the robustness and finite-sample efficiency of the method.}
}

@article{bai2026shift,
  author = {Bai, Ruiqi and Zhang, Yijiao and Yang, Hanbo and Zhu, Zhongyi},
  title = {Transfer Learning for High-dimensional Quantile Regression with Distribution Shift},
  year = {2026},
  url = {https://arxiv.org/abs/2411.19933},
  abstract = {Transfer learning can improve estimation in a target study by borrowing information from related source studies, but its effectiveness can deteriorate when the source and target distributions differ. We study high-dimensional quantile regression under three forms of distribution shift: parameter shift, covariate shift, and residual distribution shift. We introduce a transferability criterion and a transfer framework designed to remain useful under these simultaneous discrepancies. Nonasymptotic estimation bounds characterize the gains from informative sources, while source-detection results establish conditions under which transferable studies can be identified consistently. We also develop an orthogonal debiasing procedure for valid coefficient inference after transfer, leading to sharper asymptotic results. Simulation studies and real-data analyses demonstrate the benefits of the proposed procedures across a range of heterogeneous transfer settings.}
}

@article{zhang2026syntax,
  author = {Zhang, Ruqian and Zhang, Yijiao and Shen, Juan and Zhu, Zhongyi and Qu, Annie},
  title = {Syntax-Guided Diffusion Language Models with User-Integrated Personalization},
  journal = {The Annals of Applied Statistics},
  publication_status = {accepted},
  year = {2026},
  url = {https://arxiv.org/abs/2510.01028},
  abstract = {Personalized language generation requires models that capture both shared linguistic structure and user-specific patterns. We develop syntax-guided diffusion language models that incorporate structural supervision and personalized conditioning to improve generation quality, diversity, and controllability. A cascaded formulation first generates syntactic guidance and then conditions text generation on that structure, while a noncascaded alternative more tightly couples structural and lexical generation. To support personalization with limited user data, the model uses shared representations that borrow information across users while retaining user-specific lexical and syntactic preferences. This construction also enables generalization to users with limited or no task-specific observations. Experiments across multiple generation tasks show improvements in fluency, diversity, stylistic fidelity, and interpretability relative to competing approaches.}
}

@article{zhang2026mediation,
  author = {Zhang, Yijiao and Yuan, Yubai and Zhang, Yuexia and Zhu, Zhongyi and Qu, Annie},
  title = {Individualized Dynamic Mediation Analysis Using Latent Factor Models},
  journal = {Journal of the American Statistical Association},
  publication_status = {accepted},
  year = {2026},
  doi = {10.1080/01621459.2026.2641242},
  abstract = {Mediation effects in longitudinal studies can vary substantially across time and across individuals, while unmeasured time-varying confounding and a large set of candidate mediators make individualized analysis challenging. We develop a latent-factor framework that borrows shared structure across individuals while allowing heterogeneous, time-varying mediation effects. The method separates population-level mediator selection from individualized effect trajectories and uses structured regularization to identify important mediators in settings with potentially dense latent dependence. The framework also accommodates unmeasured time-varying confounders that induce heterogeneous mediation patterns. We establish asymptotic properties for the proposed estimators together with consistency for mediator selection. Extensive simulations and an application integrating DNA-methylation measurements with longitudinal cognitive outcomes illustrate the ability of the method to recover interpretable population and individual mediation patterns.}
}

@article{zhang2026concert,
  author = {Zhang, Ruqian and Zhang, Yijiao and Shen, Juan and Zhu, Zhongyi and Qu, Annie},
  title = {Covariate-Elaborated Robust Partial Information Transfer with Conditional Spike-and-Slab Prior},
  journal = {Journal of the American Statistical Association},
  publication_status = {accepted},
  year = {2026},
  doi = {10.1080/01621459.2025.2591232},
  abstract = {Statistical transfer learning often measures similarity between an entire source study and a target study, which can be inefficient when only subsets of the model are shared. We develop CONCERT, a Bayesian framework for covariate-specific partial information transfer in high-dimensional regression. A conditional spike-and-slab prior links each source coefficient to its target counterpart, allowing the model to learn which source components should be shared and which should remain source-specific, while a separate sparsity layer performs target variable selection. The resulting one-step procedure combines variable selection and information transfer and allows different sources to contribute to different coordinates. We establish variable-selection consistency, estimation and prediction guarantees, and recovery of the local transfer structure. A structured variational Bayes algorithm provides scalable computation. Simulations and applications to heterogeneous datasets demonstrate gains from borrowing information at the covariate level rather than imposing global source-target similarity.}
}

@article{yuan2025ot,
  author = {Yuan, Yubai and Zhang, Yijiao and Shahbaba, Babak and Fortin, Norbert and Cooper, Keiland and Nie, Qing and Qu, Annie},
  title = {Optimal Transport for Latent Integration with an Application to Heterogeneous Neuronal Activity Data},
  journal = {Journal of the American Statistical Association},
  volume = {120},
  number = {551},
  pages = {1449--1462},
  year = {2025},
  doi = {10.1080/01621459.2025.2540653},
  abstract = {Heterogeneous longitudinal datasets often contain common dynamic patterns that are obscured by systematic subject-to-subject variation and by the absence of direct correspondence between observations. We develop an optimal-transport framework for latent integration that first extracts low-dimensional temporal representations within each dataset and then aligns those representations across subjects. The approach is designed to reduce heterogeneity unrelated to the target signal while preserving shared dynamics and within-subject temporal dependence, and it does not require auxiliary matching information. This makes it suitable for studies with a small number of subjects but rich longitudinal measurements. The method is motivated by rodent electrophysiological recordings, where the goal is to identify neural activity patterns associated with common cognitive demands and behavior across animals. Numerical studies and neuroscience applications show that latent alignment can improve the detection and prediction of shared dynamic patterns.}
}

@article{zhang2025fqte,
  author = {Zhang, Yijiao and Zhu, Zhongyi},
  title = {A Data Fusion Method for Quantile Treatment Effects},
  journal = {Statistica Sinica},
  volume = {35},
  pages = {981--1002},
  year = {2025},
  doi = {10.5705/ss.202022.0288},
  url = {https://arxiv.org/abs/2307.07918},
  abstract = {We study data fusion for quantile treatment effects when a small validation dataset contains the confounders needed for causal identification but a larger auxiliary dataset has unmeasured confounders. We construct a fused quantile treatment effect estimator that combines the two samples through doubly robust estimating functions, using the auxiliary data to improve precision without requiring it to identify the causal target on its own. The procedure allows working models for the auxiliary sample to be misspecified. Under regularity conditions, the estimator is asymptotically normal and more efficient than an estimator based only on the validation sample. We derive asymptotic linear representations that lead to convenient covariance estimation and uncertainty quantification. Simulation studies demonstrate the finite-sample validity and efficiency gains of the method, and a real-data application illustrates its practical use.}
}

@article{zhang2025smooth,
  author = {Zhang, Yijiao and Zhu, Zhongyi},
  title = {Transfer Learning for High-dimensional Quantile Regression via Convolution Smoothing},
  journal = {Statistica Sinica},
  volume = {35},
  pages = {939--958},
  year = {2025},
  doi = {10.5705/ss.202022.0396},
  url = {https://arxiv.org/abs/2212.00428},
  abstract = {We study transfer learning for high-dimensional quantile regression when related source datasets may improve estimation and prediction for a target population. When the set of transferable sources is known, we propose a two-step transfer procedure based on convolution smoothing, which replaces the nonsmooth quantile loss with a smooth objective and enables scalable high-dimensional optimization. We establish l1 and l2 estimation error bounds for the resulting estimator. Because some sources may be uninformative or harmful, we also develop an adaptive source-selection procedure and give conditions for consistent identification of transferable sources. The theory quantifies when borrowing across studies improves target estimation while controlling negative transfer. Monte Carlo experiments and an analysis of gene-expression data demonstrate the effectiveness of the smoothed transfer procedure and adaptive source screening.}
}
